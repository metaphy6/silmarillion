{
  "schema_version": 1,
  "status": "proposed-portable-contract",
  "authority": "Functional interface values; decorative artwork palettes are independent.",
  "units": "logical CSS px for reference only; engine adapters must preserve perceived size",
  "color": {
    "canvas": "#101C22",
    "surface": "#192A30",
    "surfaceRaised": "#233940",
    "ink": "#F2E8D5",
    "muted": "#B8C8C9",
    "border": "#7E9699",
    "accent": "#EDBE73",
    "onAccent": "#14242A",
    "focus": "#A1DCE6",
    "danger": "#FFB4A4",
    "success": "#B8D6A4",
    "information": "#A1DCE6",
    "unknown": "#C8BED9",
    "disabledInk": "#B8C8C9",
    "overlayRoute": "#F2E8D5",
    "overlayThreat": "#FFB4A4",
    "overlaySupply": "#A1DCE6"
  },
  "permitted_pairings": [
    {
      "foreground": "ink",
      "background": "canvas",
      "minimum_ratio": 4.5,
      "use": "body"
    },
    {
      "foreground": "ink",
      "background": "surface",
      "minimum_ratio": 4.5,
      "use": "body"
    },
    {
      "foreground": "ink",
      "background": "surfaceRaised",
      "minimum_ratio": 4.5,
      "use": "body"
    },
    {
      "foreground": "muted",
      "background": "surface",
      "minimum_ratio": 4.5,
      "use": "secondary text"
    },
    {
      "foreground": "muted",
      "background": "surfaceRaised",
      "minimum_ratio": 4.5,
      "use": "secondary text"
    },
    {
      "foreground": "accent",
      "background": "surface",
      "minimum_ratio": 4.5,
      "use": "emphasis text"
    },
    {
      "foreground": "onAccent",
      "background": "accent",
      "minimum_ratio": 4.5,
      "use": "primary action text"
    },
    {
      "foreground": "danger",
      "background": "surface",
      "minimum_ratio": 4.5,
      "use": "warning text plus triangle"
    },
    {
      "foreground": "success",
      "background": "surface",
      "minimum_ratio": 4.5,
      "use": "available text plus check"
    },
    {
      "foreground": "unknown",
      "background": "surface",
      "minimum_ratio": 4.5,
      "use": "uncertain evidence label"
    },
    {
      "foreground": "disabledInk",
      "background": "surface",
      "minimum_ratio": 4.5,
      "use": "unavailable action reason"
    },
    {
      "foreground": "focus",
      "background": "canvas",
      "minimum_ratio": 3,
      "use": "outer focus"
    },
    {
      "foreground": "focus",
      "background": "surface",
      "minimum_ratio": 3,
      "use": "outer focus"
    },
    {
      "foreground": "border",
      "background": "surface",
      "minimum_ratio": 3,
      "use": "control boundary"
    },
    {
      "foreground": "border",
      "background": "surfaceRaised",
      "minimum_ratio": 3,
      "use": "control boundary"
    },
    {
      "foreground": "muted",
      "background": "canvas",
      "minimum_ratio": 4.5,
      "use": "secondary gallery and world-context text"
    },
    {
      "foreground": "accent",
      "background": "surfaceRaised",
      "minimum_ratio": 4.5,
      "use": "selected navigation emphasis while hovered"
    },
    {
      "foreground": "information",
      "background": "canvas",
      "minimum_ratio": 4.5,
      "use": "resource links"
    },
    {
      "foreground": "information",
      "background": "surface",
      "minimum_ratio": 4.5,
      "use": "resource links inside panels"
    }
  ],
  "typography": {
    "display": {
      "family": [
        "Noto Serif",
        "Georgia",
        "serif"
      ],
      "weight": 400,
      "size": 32,
      "line_height": 1.18,
      "use": "scene and inspection titles only"
    },
    "body": {
      "family": [
        "Noto Sans",
        "Arial",
        "sans-serif"
      ],
      "weight": 400,
      "size": 16,
      "line_height": 1.5
    },
    "label": {
      "family": [
        "Noto Sans",
        "Arial",
        "sans-serif"
      ],
      "weight": 600,
      "size": 14,
      "line_height": 1.45
    },
    "number": {
      "family": [
        "Noto Sans",
        "Arial",
        "sans-serif"
      ],
      "weight": 600,
      "size": 16,
      "line_height": 1.5,
      "features": [
        "tabular-nums"
      ]
    },
    "minimum_text": 14,
    "scale_range": [
      1,
      2
    ],
    "dialogue_max_measure_ch": 62,
    "diacritic_test": "Númenor · Fëanor · Aulë · Eönwë · Lórien · Nienna · Alatar · Pallando",
    "font_policy": "System fallbacks only in gallery. No font file vendored. Verify each target font covers complete localized text before bundling with its license.",
    "heading": {
      "family": [
        "Noto Serif",
        "Georgia",
        "serif"
      ],
      "weight": 400,
      "size": 24,
      "line_height": 1.18,
      "use": "panel and gallery headings"
    }
  },
  "spacing": {
    "unit": 4,
    "steps": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ]
  },
  "surface": {
    "corner_radius": 2,
    "border_width": 1,
    "reading_opacity": 1,
    "texture": "outside reading surfaces only",
    "shadow": "0 6px 24px #101C2266"
  },
  "icon": {
    "grid": 24,
    "stroke": 2,
    "minimum_label_gap": 8,
    "style": "open, angular line pictograms; filled silhouette only for selected state",
    "resources": {
      "P": "grain with letter P and Provisions",
      "M": "joined blocks with letter M and Materials",
      "K": "bound leaves with letter K and Lore supplies",
      "E": "hollow spark with letter E and Essence"
    },
    "decorative_policy": "Do not use Tengwar-like glyphs as the only functional symbol."
  },
  "selection": {
    "target_minimum": 44,
    "focus_width": 3,
    "focus_offset": 3,
    "map_marker_outer_stroke": 6,
    "map_marker_inner_stroke": 3,
    "marker_labels": "Name and selected/owner status on opaque backing",
    "occlusion": "Show outline or pin and list entry; never move or enlarge the actual unit to clear a tree."
  },
  "overlay": {
    "route": {
      "stroke": 3,
      "pattern": "solid with arrowheads",
      "label": "Planned route"
    },
    "uncertain": {
      "stroke": 3,
      "pattern": "dashed",
      "label": "Unconfirmed route"
    },
    "supply": {
      "stroke": 3,
      "pattern": "double with square nodes",
      "label": "Supply connection"
    },
    "threat": {
      "stroke": 3,
      "pattern": "hatched boundary and triangle",
      "label": "Warned area"
    },
    "halo": {
      "color": "#101C22",
      "stroke": 7
    },
    "rule": "All map lines need dark casing; read values in opaque labels, never from paint."
  },
  "motion": {
    "hover_ms": 120,
    "panel_ms": 180,
    "selection_ms": 120,
    "maximum_flash_hz": 0,
    "reduced_motion": {
      "durations_ms": 0,
      "camera_flight": false,
      "parallax": false,
      "ambient_loops": false
    },
    "sound": "Event cues have visual equivalents; independent interface/voice/ambience volume and mute."
  },
  "states": {
    "default": "surface + ink + border",
    "hover": "surfaceRaised + ink + explicit boundary",
    "focus": "default plus focus ring",
    "selected": "accent border + named selected status",
    "pressed": "onAccent on accent",
    "unavailable": "surface + disabledInk + lock and specific reason; no opacity fade",
    "pending": "clock + completion turn + cancel consequence",
    "danger": "danger text + triangle + review step; no flashing",
    "uncertain": "unknown text + dashed outline + source age",
    "complete": "success text + check + factual result"
  },
  "provisional_views": {
    "reference_width": 1440,
    "reference_height": 900,
    "compact_width": 1024,
    "text_scale_test": 2,
    "strategic_figure_height": [
      10,
      18
    ],
    "local_figure_height": [
      18,
      28
    ],
    "strategic_landscape_area_minimum_fraction": 0.7,
    "inspection_portrait_width": [
      176,
      280
    ],
    "projection": "orthographic oblique, starting pitch 35 degrees and yaw 45 degrees; camera angle not canonical or engine binding"
  }
}
